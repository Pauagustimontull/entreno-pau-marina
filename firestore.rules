rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo vosotros dos podéis entrar. Cambia los correos por los vuestros (los de Google con los que iniciáis sesión).
    function esDeLaPareja() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['pauagustimontull@gmail.com', 'CORREO_DE_MARINA@gmail.com'];
    }

    match /profiles/{perfil}/docs/{documento} {
      allow read, write: if esDeLaPareja() && perfil in ['pau', 'marina'];
    }
  }
}
